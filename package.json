{
  "name": "nexus-tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run mcp:views && next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "node scripts/copy-draco.mjs && node scripts/copy-plan-font.mjs",
    "import:place-images": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/import-place-images.ts",
    "sync:inventory-locations": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/sync-inventory-locations.ts",
    "import:places": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/import-places.ts",
    "import:catalogue": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/import-catalogue.ts",
    "import:game-data": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/import-game-data.ts",
    "merge:blueprints": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/merge-duplicate-blueprints.ts",
    "ensure:indexes": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/ensure-indexes.ts",
    "clean:blobs": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/clean-orphan-blobs.ts",
    "backfill:banners": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/backfill-place-banners.ts",
    "import:celestial-bodies": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/import-celestial-bodies.ts",
    "import:star-map": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/import-star-map.ts",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts",
    "mcp:smoke:seed": "tsx --env-file-if-exists=.env.local scripts/mcp-smoke-seed.ts",
    "mcp:views": "vite build --config mcp-views/vite.config.ts"
  },

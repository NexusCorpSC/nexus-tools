    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
